# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Used by worker/boot.sh on each agent VM.

# Head private IP (worker join target — private network only)
HEAD_PRIVATE_IP=10.0.0.3

# From head after boot:
#   sudo cat /var/lib/rancher/k3s/server/node-token
K3S_TOKEN=

# Optional: override auto-detected name/IP
K3S_NODE_NAME=
WORKER_PRIVATE_IP=
FLANNEL_IFACE=enp7s0

# --- k3s ---
K3S_CHANNEL=stable
K3S_VERSION=
