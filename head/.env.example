# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Used by head/boot.sh on the control-plane VM.

# --- Network ---
HEAD_PRIVATE_IP=10.0.0.3
HEAD_PUBLIC_IP=203.0.113.10
CLUSTER_DOMAIN=api.example.com
FLANNEL_IFACE=enp7s0

# --- Domains (A records → HEAD_PUBLIC_IP) ---
# Portainer is NOT public — use Tailscale MagicDNS instead (see TS_* below).
BASE_DOMAIN=k3s.example.com
API_HOST=api.example.com
TRAEFIK_HOST=traefik.example.com
APP_HOST=app.example.com
LONGHORN_HOST=longhorn.example.com

# --- ACME / TLS ---
ACME_EMAIL=admin@example.com

# --- Traefik dashboard basic auth ---
TRAEFIK_DASH_USER=admin
TRAEFIK_DASH_PASS=ChangeMe-Traefik-Admin-123!

# --- Tailscale (private Portainer; do not expose Portainer on the public internet) ---
# Create OAuth client: https://login.tailscale.com/admin/settings/oauth
# Scopes: devices:core + auth_keys (write)
TS_CLIENT_ID=
TS_CLIENT_SECRET=
TS_OPERATOR_HOSTNAME=k3s-tailscale-operator
# MagicDNS label → https://portainer.<your-tailnet>.ts.net
PORTAINER_TS_HOSTNAME=portainer
# Set false to skip operator install in deployment-setup/install-platform.sh
INSTALL_TAILSCALE=true

# --- k3s ---
K3S_CHANNEL=stable
K3S_VERSION=
KUBE_USER=

# --- Optional SSH inventory (for remote orchestration) ---
SSH_USER=ubuntu
SSH_PORT=22
SSH_KEY=../ssh.pem

# --- Postgres app passwords (mirrored into deployment-setup/secrets) ---
POSTGRES_APP_PASSWORD=ChangeMe-App-Password-123!
POSTGRES_SUPERUSER_PASSWORD=ChangeMe-Postgres-Password-123!

# --- AWS S3 backups (CloudNativePG / Barman) ---
# Create an IAM user/role with s3:ListBucket, s3:GetObject, s3:PutObject, s3:DeleteObject
# on the bucket prefix below. Prefer IAM roles / IRSA in production when available.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=ChangeMe-Aws-Secret-Access-Key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-company-k3s-postgres-backups
# Full Barman destination (must match cluster manifest destinationPath)
AWS_S3_DESTINATION_PATH=s3://your-company-k3s-postgres-backups/postgres-ha/
